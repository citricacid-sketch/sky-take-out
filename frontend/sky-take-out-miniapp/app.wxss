/* app.wxss */
/* =====================================================================
   DESIGN SYSTEM — Warm Modern Takeaway
   Native WeChat Mini Program user-facing client.
   Single source of truth for visual tokens. Pages/components MUST consume
   these variables instead of hardcoding values.
   ===================================================================== */

page {
  /* ---- Color palette ---- */
  --color-primary: #D97706;
  --color-primary-dark: #B45309;
  --color-primary-soft: #FEF3C7;
  --color-accent: #059669;
  --color-accent-soft: #ECFDF5;
  --color-danger: #DC2626;
  --color-neutral-soft: #F5F5F4;
  --color-bg: #FFFBF5;
  --color-surface: #FFFFFF;
  --color-surface-alt: #FAFAF9;
  --color-text: #292524;
  --color-text-secondary: #57534E;
  --color-text-tertiary: #A8A29E;
  --color-border: #E7E5E4;

  /* ---- Spacing scale (rpx) ---- */
  --sp-xs: 8rpx;
  --sp-sm: 12rpx;
  --sp-md: 16rpx;
  --sp-lg: 24rpx;
  --sp-xl: 32rpx;
  --sp-2xl: 40rpx;
  --sp-3xl: 48rpx;
  --sp-4xl: 64rpx;

  /* ---- Radius ---- */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 20rpx;
  --radius-pill: 999rpx;

  /* ---- Shadow (used sparingly) ---- */
  --shadow-sm: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(41, 37, 36, 0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(41, 37, 36, 0.12);
  --shadow-top: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  /* Warm colored shadows — for primary buttons & elevated cards */
  --shadow-primary: 0 8rpx 24rpx rgba(217, 119, 6, 0.28);
  --shadow-primary-sm: 0 4rpx 12rpx rgba(217, 119, 6, 0.22);
  --shadow-float: 0 12rpx 40rpx rgba(41, 37, 36, 0.14);

  /* ---- Primary gradient (warm modern) ---- */
  --gradient-primary: linear-gradient(135deg, #D97706 0%, #F59E0B 100%);
  --gradient-primary-active: linear-gradient(135deg, #B45309 0%, #D97706 100%);

  /* ---- Typography ---- */
  --font-page-title: 700 44rpx/1.3 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --font-section-title: 600 32rpx/1.3 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --font-product-name: 500 30rpx/1.4 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --font-price: 700 36rpx/1.2 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --font-price-lg: 800 48rpx/1.1 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --font-body: 400 26rpx/1.5 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --font-secondary: 400 24rpx/1.4 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --font-caption: 400 22rpx/1.3 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --font-button: 600 30rpx/1 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  --font-tab: 400 20rpx/1 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;

  background-color: var(--color-bg);
  color: var(--color-text);
  font: var(--font-body);
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea { box-sizing: border-box; }

/* ---- Reusable atoms ---- */
.page { min-height: 100vh; background: var(--color-bg); }
.page-pad { padding: var(--sp-lg); padding-bottom: calc(var(--sp-lg) + 120rpx); }

.card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  color: #fff;
  font: var(--font-button);
  border-radius: var(--radius-pill);
  height: 88rpx;
  padding: 24rpx 64rpx;
  border: none;
  box-sizing: border-box;
}
.btn-primary:active { background: var(--color-primary-dark); }
.btn-primary[disabled] { background: var(--color-text-tertiary); color: #fff; }

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface);
  color: var(--color-primary);
  font: var(--font-button);
  border-radius: var(--radius-pill);
  padding: 22rpx 48rpx;
  border: 2rpx solid var(--color-primary);
}

.price { font: var(--font-price); color: var(--color-primary); }
.price-lg { font: var(--font-price-lg); color: var(--color-primary); }

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
  font: var(--font-caption);
}

.tag-success {
  background: #ECFDF5;
  color: #059669;
}

.tag-muted {
  background: #F5F5F4;
  color: var(--color-text-tertiary);
}

.divider { height: 1rpx; background: var(--color-border); margin: var(--sp-lg) 0; }

.muted { color: var(--color-text-secondary); }
.faint { color: var(--color-text-tertiary); }
.text-sm { font: var(--font-secondary); }
.text-xs { font: var(--font-caption); }

/* ---- Glassmorphism ---- */
.glass {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}
.glass-dark {
  background: rgba(41, 37, 36, 0.45);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

/* ---- Image bottom gradient overlay (for text on images) ---- */
.img-overlay-bottom {
  position: relative;
}
.img-overlay-bottom::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.18) 60%, transparent 100%);
  pointer-events: none;
  z-index: 1;
}
.img-overlay-bottom > .overlay-content {
  position: relative;
  z-index: 2;
}

/* ---- Keyframes ---- */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes popIn {
  0% { transform: scale(1); }
  50% { transform: scale(0.92); }
  100% { transform: scale(1); }
}
@keyframes dotBounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
  40% { transform: translateY(-8rpx); opacity: 1; }
}
@keyframes gentlePulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(217, 119, 6, 0.35); }
  50% { box-shadow: 0 0 0 16rpx rgba(217, 119, 6, 0); }
}
.fade-up { animation: fadeUp 0.45s ease-out both; }
.pop-in:active { animation: popIn 0.2s ease-out; }
