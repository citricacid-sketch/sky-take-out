/* pages/dish-detail/dish-detail.wxss */
/* Modern warm takeaway — immersive hero, tactile spec pills, glass action bar. */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* Top bar */
.topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-lg);
  padding-top: calc(var(--sp-lg) + env(safe-area-inset-top));
}

.back {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  color: var(--color-text);
  box-shadow: var(--shadow-md);
}

.back:active {
  transform: scale(0.92);
}

.cart-shortcut {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-md);
}

.cart-shortcut:active {
  transform: scale(0.95);
}

.cart-ico-img {
  width: 32rpx;
  height: 32rpx;
}

.cart-label {
  font: var(--font-caption);
  color: var(--color-text-secondary);
}

/* Hero image */
.hero-img-wrap {
  width: 100%;
  height: 480rpx;
  position: relative;
}

.hero-img {
  width: 100%;
  height: 100%;
  background: var(--color-border);
  display: block;
}

.hero-img-wrap::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 35%;
  background: linear-gradient(to top, var(--color-bg) 0%, rgba(255, 251, 245, 0.6) 50%, transparent 100%);
  pointer-events: none;
}

.hero-img-placeholder {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ph-icon-lg {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.7;
}

/* Dish info */
.dish-info {
  padding: var(--sp-xl);
  background: var(--color-surface);
}

.dish-name {
  font: 700 36rpx/1.3 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text);
}

.dish-price {
  font: var(--font-price-lg);
  color: var(--color-primary);
  margin-top: var(--sp-sm);
  display: inline-block;
}

.dish-desc {
  font: var(--font-body);
  color: var(--color-text-secondary);
  margin-top: var(--sp-md);
  line-height: 1.7;
}

/* Spec section */
.spec-section {
  padding: var(--sp-xl);
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
}

.spec-section-title {
  font: var(--font-section-title);
  color: var(--color-text);
  margin-bottom: var(--sp-lg);
}

.flavor-group {
  margin-bottom: var(--sp-lg);
}

.flavor-group:last-child {
  margin-bottom: 0;
}

.flavor-name {
  font: 500 26rpx/1 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text-secondary);
  margin-bottom: var(--sp-md);
}

.flavor-options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-md);
}

.flavor-pill {
  padding: 14rpx 32rpx;
  border-radius: var(--radius-pill);
  background: var(--color-surface-alt);
  border: 2rpx solid var(--color-border);
  font: var(--font-secondary);
  color: var(--color-text-secondary);
  transition: all 0.2s ease;
}

.flavor-pill:active {
  transform: scale(0.96);
}

.flavor-pill.active {
  background: var(--gradient-primary);
  color: #fff;
  border-color: transparent;
  font-weight: 600;
  box-shadow: var(--shadow-primary-sm);
  transform: scale(1.04);
}

/* Fixed bottom action bar — glass effect */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-lg);
  height: 120rpx;
  padding: 0 var(--sp-xl);
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.qty-control {
  display: flex;
  align-items: center;
  gap: var(--sp-lg);
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-surface-alt);
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.qty-btn:active {
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
  transform: scale(0.9);
}

.qty-num {
  font: 600 30rpx/1 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text);
  min-width: 48rpx;
  text-align: center;
}

.add-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gradient-primary);
  color: #fff;
  font: var(--font-button);
  border-radius: var(--radius-pill);
  height: 88rpx;
  box-shadow: var(--shadow-primary);
  letter-spacing: 1rpx;
}

.add-btn:active {
  background: var(--gradient-primary-active);
  transform: scale(0.98);
}

.add-btn.disabled {
  background: var(--color-text-tertiary);
  box-shadow: none;
}

.safe-bottom {
  height: var(--sp-3xl);
}
