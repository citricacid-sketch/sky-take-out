# AI Service 环境变量配置
# 复制为 .env 并填写真实值

# --- LLM (与 Java 同名环境变量保持一致) ---
LLM_API_KEY=
LLM_BASE_URL=https://longcat.chat/v1/chat/completions
LLM_MODEL=Longcat-Flash-Chat
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_SQL_TEMPERATURE=0.1

# --- 查询限制 ---
AI_QUERY_TIMEOUT_MS=5000
AI_QUERY_MAX_ROWS=100

# --- MySQL (sky_ai_ro 只读账号) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=sky_take_out
MYSQL_USER=sky_ai_ro
MYSQL_PASSWORD=

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- 服务 ---
AI_SERVICE_TOKEN=
AI_SERVICE_PORT=8000
