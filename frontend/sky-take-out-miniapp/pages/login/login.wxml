<!-- pages/login/login.wxml -->
<!-- On-demand login page. Not forced on launch. Shows logged-in state if already authenticated. -->

<view class="page">
  <view class="brand">
    <view class="brand-logo">鲜</view>
    <view class="brand-name">鲜味小厨</view>
    <view class="brand-sub" wx:if="{{!isLoggedIn}}">欢迎回来，请使用微信登录</view>
    <view class="brand-sub" wx:else>您已登录</view>
  </view>

  <view class="actions">
    <button wx:if="{{!isLoggedIn}}" class="btn-primary btn-block" bindtap="onWxLogin" loading="{{loading}}">
      微信一键登录
    </button>
    <button wx:if="{{isLoggedIn}}" class="btn-ghost btn-block" bindtap="onLogout">
      退出登录
    </button>
    <button class="btn-ghost btn-block" bindtap="onBack">稍后再说</button>
  </view>

  <view class="tac">
    登录即表示同意《用户协议》和《隐私政策》
  </view>

  <view class="safe-bottom"></view>
</view>
