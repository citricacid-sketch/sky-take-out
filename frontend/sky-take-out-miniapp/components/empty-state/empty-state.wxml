<!-- components/empty-state/empty-state.wxml -->
<view class="empty-state">
  <view class="empty-symbol">{{symbolText}}</view>
  <view class="empty-title">{{title}}</view>
  <view wx:if="{{subtitle}}" class="empty-subtitle">{{subtitle}}</view>
  <view wx:if="{{actionText}}" class="empty-action" bindtap="onAction">{{actionText}}</view>
</view>
