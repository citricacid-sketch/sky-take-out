/* components/toast/toast.wxss */
.toast-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.toast {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 40rpx;
  background: rgba(41, 37, 36, 0.92);
  border-radius: var(--radius-md);
  color: #fff;
  font-size: 28rpx;
  max-width: 70%;
}

.toast-text {
  font-size: 28rpx;
}

.toast-loading {
  padding: 24rpx 48rpx;
}

.toast-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
