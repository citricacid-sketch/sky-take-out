/* components/loading-skeleton/loading-skeleton.wxss */
.skeleton {
  padding: 24rpx;
}

.sk-title {
  height: 40rpx;
  margin-bottom: 24rpx;
  border-radius: 8rpx;
}

.sk-block {
  display: flex;
  margin-bottom: 24rpx;
}

.sk-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 50%, #f3f4f6 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.sk-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.sk-line {
  height: 28rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 50%, #f3f4f6 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.sk-line:last-child {
  margin-bottom: 0;
}
