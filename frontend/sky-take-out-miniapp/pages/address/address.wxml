<!-- pages/address/address.wxml -->
<!-- Address book list with set-default / edit / delete, plus add button. -->

<view class="page">
  <view wx:if="{{addresses.length}}" class="addr-list">
    <view wx:for="{{addresses}}" wx:key="id" class="addr-card">
      <view class="addr-info" data-id="{{item.id}}" bindtap="onEdit">
        <view class="addr-line">
          <text class="addr-consignee">{{item.consignee}}</text>
          <text class="addr-phone">{{item.phone}}</text>
          <view wx:if="{{item.isDefault}}" class="default-tag">默认</view>
        </view>
        <view class="addr-line">
          <text wx:if="{{item.label}}" class="label-tag">{{item.label}}</text>
          <text class="addr-full">{{item.fullAddr}}</text>
        </view>
      </view>
      <view class="addr-actions">
        <view
          wx:if="{{!item.isDefault}}"
          class="act"
          data-id="{{item.id}}"
          bindtap="onSetDefault"
        >
          设为默认
        </view>
        <view class="act" data-id="{{item.id}}" bindtap="onEdit">编辑</view>
        <view class="act act-danger" data-id="{{item.id}}" bindtap="onDelete">删除</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!addresses.length && !loading}}" class="empty-wrap">
    <empty-state
      title="暂无收货地址"
      subtitle="请添加收货地址"
      actionText="添加地址"
      bind:action="onAdd"
    />
  </view>

  <view class="safe-bottom"></view>

  <!-- Fixed add button -->
  <view class="add-bar">
    <view class="add-btn" bindtap="onAdd">+ 新增收货地址</view>
  </view>
</view>
