/* components/scroll-to-top/scroll-to-top.wxss */
.scroll-to-top {
  position: fixed;
  right: 24rpx;
  bottom: 160rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
  transition: opacity 0.3s ease;
}

.scroll-to-top:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.2);
}

.icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.7;
}
