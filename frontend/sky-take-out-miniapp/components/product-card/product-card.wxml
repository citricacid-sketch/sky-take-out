<!-- components/product-card/product-card.wxml -->
<!-- Three modes controlled by `mode`: list | featured | compact -->

<!-- LIST mode: horizontal row, used in menu / search -->
<view wx:if="{{mode === 'list'}}" class="card-list" bindtap="onTap">
  <view class="img-list-wrap">
    <image wx:if="{{hasImage}}" class="img-list" src="{{product.image}}" mode="aspectFill" lazy-load="{{true}}" binderror="onImageError" />
    <view wx:else class="img-placeholder img-placeholder-list">
      <image class="ph-icon" src="/assets/icons/dish.svg" mode="aspectFit" />
    </view>
  </view>
  <view class="body-list">
    <text class="name-list">{{product.name}}</text>
    <text wx:if="{{product.description}}" class="desc-list">{{product.description}}</text>
    <view class="meta-list">
      <text wx:if="{{salesText}}" class="sales">{{salesText}}</text>
      <text wx:if="{{product.flavors && product.flavors.length}}" class="spec-hint">选规格</text>
    </view>
    <view class="bottom-list">
      <text class="price">¥{{priceText}}</text>
      <view class="add-btn" catchtap="onAdd">
        <text>+</text>
      </view>
    </view>
  </view>
</view>

<!-- FEATURED mode: vertical card, used in homepage recommendation ribbon -->
<view wx:if="{{mode === 'featured'}}" class="card-featured" bindtap="onTap">
  <view class="img-featured-wrap">
    <image wx:if="{{hasImage}}" class="img-featured" src="{{product.image}}" mode="aspectFill" lazy-load="{{true}}" binderror="onImageError" />
    <view wx:else class="img-placeholder img-placeholder-featured">
      <image class="ph-icon" src="/assets/icons/dish.svg" mode="aspectFit" />
    </view>
  </view>
  <view class="body-featured">
    <text class="name-featured">{{product.name}}</text>
    <view class="row-featured">
      <text class="price-featured">¥{{priceText}}</text>
      <view class="add-btn-round" catchtap="onAdd">
        <text>+</text>
      </view>
    </view>
  </view>
</view>

<!-- COMPACT mode: small row, used in cart / order detail -->
<view wx:if="{{mode === 'compact'}}" class="card-compact">
  <image class="img-compact" src="{{product.image}}" mode="aspectFill" lazy-load="{{true}}" binderror="onImageErrorCompact" />
  <view wx:else class="img-placeholder img-placeholder-compact">
    <image class="ph-icon" src="/assets/icons/dish.svg" mode="aspectFit" />
  </view>
  <view class="body-compact">
    <text class="name-compact">{{product.name}}</text>
    <text wx:if="{{product.dishFlavor}}" class="flavor-compact">{{product.dishFlavor}}</text>
  </view>
  <view class="right-compact">
    <text class="qty-compact">×{{product.number}}</text>
    <text class="price-compact">¥{{priceText}}</text>
  </view>
</view>
