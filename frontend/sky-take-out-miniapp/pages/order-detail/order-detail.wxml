<!-- pages/order-detail/order-detail.wxml -->
<!-- Order detail: status + info + items + amount + dynamic action buttons. -->

<view class="page" wx:if="{{order}}">
  <!-- Status banner -->
  <view class="status-banner">
    <view class="status-text">{{order.statusText}}</view>
    <view class="status-number">订单号：{{order.number}}</view>
  </view>

  <!-- Info -->
  <view class="section info-section">
    <view class="info-row">
      <text class="info-label">下单时间</text>
      <text class="info-val">{{order.orderTime}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">收货地址</text>
      <text class="info-val">{{order.address}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">联系电话</text>
      <text class="info-val">{{order.phone}}</text>
    </view>
    <view wx:if="{{order.remark}}" class="info-row">
      <text class="info-label">备注</text>
      <text class="info-val">{{order.remark}}</text>
    </view>
  </view>

  <!-- Items -->
  <view class="section">
    <view class="section-title">商品明细</view>
    <view wx:for="{{items}}" wx:key="id" class="line-row">
      <view class="line-img-wrap">
        <image wx:if="{{item.hasImage}}" class="line-img" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}" />
        <view wx:else class="line-img line-img-placeholder">
          <image class="ph-icon" src="/assets/icons/dish.svg" mode="aspectFit" />
        </view>
      </view>
      <view class="line-body">
        <text class="line-name">{{item.name}}</text>
        <text wx:if="{{item.flavorText}}" class="line-flavor">{{item.flavorText}}</text>
      </view>
      <view class="line-right">
        <text class="line-qty">×{{item.number}}</text>
        <text class="line-sub">{{item.subtotalText}}</text>
      </view>
    </view>
    <view class="total-row">
      <text class="total-label">实付金额</text>
      <text class="total-val">¥{{order.amountText}}</text>
    </view>
  </view>

  <view class="safe-bottom"></view>

  <!-- Dynamic action buttons -->
  <view class="action-bar">
    <view
      wx:if="{{order.status === 5 || order.status === 6}}"
      class="act-btn act-ghost"
      bindtap="onRepetition"
    >
      再来一单
    </view>
    <view
      wx:if="{{order.status === 3 || order.status === 4}}"
      class="act-btn act-ghost"
      bindtap="onReminder"
    >
      催单
    </view>
    <view
      wx:for="{{actions}}"
      wx:key="action"
      class="act-btn {{item.action === 'PAY' ? 'act-primary' : 'act-ghost'}}"
      data-code="{{item.action}}"
      bindtap="onAction"
    >
      {{item.label}}
    </view>
  </view>

  <!-- AI Customer Service -->
  <ai-chat />
</view>

<!-- Empty / error fallback when order fails to load -->
<view wx:elif="{{id}}" class="page">
  <empty-state
    title="订单加载失败"
    subtitle="请稍后再试"
    actionText="返回"
    bind:action="onBack"
  />
</view>
