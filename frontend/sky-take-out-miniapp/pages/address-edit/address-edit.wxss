/* pages/address-edit/address-edit.wxss */
.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.form {
  background: var(--color-surface);
  margin: var(--sp-lg);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--color-border);
  padding: 0 var(--sp-xl);
}

.row {
  display: flex;
  align-items: center;
  padding: var(--sp-lg) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.row:last-child {
  border-bottom: none;
}

.row-between {
  justify-content: space-between;
}

.label {
  width: 160rpx;
  font: var(--font-secondary);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.input {
  flex: 1;
  font: var(--font-body);
  color: var(--color-text);
}

.input.placeholder {
  color: var(--color-text-tertiary);
}

.arrow {
  font-size: 40rpx;
  color: var(--color-text-tertiary);
  font-weight: 700;
  line-height: 1;
}

.radio-row {
  display: flex;
  gap: var(--sp-xl);
}

.radio-label {
  display: flex;
  align-items: center;
  gap: var(--sp-sm);
  font: var(--font-body);
  color: var(--color-text);
}

.label-row {
  display: flex;
  flex: 1;
  gap: var(--sp-md);
}

.label-pill {
  padding: 10rpx 28rpx;
  border-radius: var(--radius-pill);
  background: var(--color-surface-alt);
  border: 2rpx solid transparent;
  font: var(--font-secondary);
  color: var(--color-text-secondary);
}

.label-pill.active {
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
  border-color: var(--color-primary);
}

/* Fixed save bar */
.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--sp-lg);
  padding-bottom: calc(var(--sp-lg) + env(safe-area-inset-bottom));
  background: var(--color-surface);
  box-shadow: var(--shadow-top);
}

.save-btn {
  background: var(--color-primary);
  color: #fff;
  font: var(--font-button);
  border-radius: var(--radius-pill);
  padding: 24rpx;
  text-align: center;
}

.save-btn:active {
  background: var(--color-primary-dark);
}

.save-btn.disabled {
  background: var(--color-text-tertiary);
}

/* Region picker overlay */
.picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.picker-panel {
  width: 100%;
  background: var(--color-surface);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-lg) var(--sp-xl);
  border-bottom: 1rpx solid var(--color-border);
}

.picker-cancel {
  font: var(--font-body);
  color: var(--color-text-tertiary);
}

.picker-title {
  font: var(--font-product-name);
  color: var(--color-text);
  font-weight: 600;
}

.picker-confirm {
  font: var(--font-body);
  color: var(--color-primary);
  font-weight: 600;
}

.picker-view {
  width: 100%;
  height: 500rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font: var(--font-body);
  color: var(--color-text);
}

.safe-bottom {
  height: var(--sp-3xl);
}
