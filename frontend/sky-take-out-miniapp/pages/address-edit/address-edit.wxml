<!-- pages/address-edit/address-edit.wxml -->
<!-- Address form: consignee, phone, sex, cascading region picker, detail, label, default. -->

<view class="page">
  <view class="form">
    <view class="row">
      <text class="label">收货人</text>
      <input class="input" placeholder="姓名" data-field="consignee" bindinput="onInput" value="{{form.consignee}}" />
    </view>
    <view class="row">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="手机号" data-field="phone" bindinput="onInput" value="{{form.phone}}" />
    </view>
    <view class="row">
      <text class="label">性别</text>
      <radio-group class="radio-row" bindchange="onSexChange">
        <label class="radio-label">
          <radio value="1" checked="{{form.sex === '1'}}" />先生
        </label>
        <label class="radio-label">
          <radio value="0" checked="{{form.sex === '0'}}" />女士
        </label>
      </radio-group>
    </view>
    <view class="row" bindtap="onRegionTap">
      <text class="label">所在地区</text>
      <text class="input {{(form.provinceName ? '' : 'placeholder')}}">
        {{form.provinceName}} {{form.cityName}} {{form.districtName}}
      </text>
      <text class="arrow">›</text>
    </view>
    <view class="row">
      <text class="label">详细地址</text>
      <input class="input" placeholder="街道、楼栋、门牌号" data-field="detail" bindinput="onInput" value="{{form.detail}}" />
    </view>
    <view class="row">
      <text class="label">标签</text>
      <view class="label-row">
        <view
          wx:for="{{labels}}"
          wx:key="*this"
          class="label-pill {{form.label === item ? 'active' : ''}}"
          data-label="{{item}}"
          bindtap="onLabelTap"
        >
          {{item}}
        </view>
      </view>
    </view>
    <view class="row row-between">
      <text class="label">设为默认</text>
      <switch checked="{{form.isDefault}}" color="#D97706" bindchange="onDefaultChange" />
    </view>
  </view>

  <view class="safe-bottom"></view>

  <!-- Fixed save button -->
  <view class="save-bar">
    <view class="save-btn {{saving ? 'disabled' : ''}}" bindtap="onSave" loading="{{saving}}">
      保存
    </view>
  </view>

  <!-- Region picker overlay -->
  <view wx:if="{{showRegionPicker}}" class="picker-mask" bindtap="onRegionClose">
    <view class="picker-panel" catchtap="">
      <view class="picker-head">
        <text class="picker-cancel" bindtap="onRegionClose">取消</text>
        <text class="picker-title">选择地区</text>
        <text class="picker-confirm" bindtap="onRegionClose">确定</text>
      </view>
      <picker-view class="picker-view" bindchange="onRegionChange" value="{{regionIndexes}}">
        <picker-view-column>
          <view wx:for="{{regionColumns[0]}}" wx:key="*this" class="picker-item">{{item}}</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{regionColumns[1]}}" wx:key="*this" class="picker-item">{{item}}</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{regionColumns[2]}}" wx:key="*this" class="picker-item">{{item}}</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>
</view>
