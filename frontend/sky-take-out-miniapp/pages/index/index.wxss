/* pages/index/index.wxss */
/* Modern warm takeaway — media cards, gradient CTA, refined micro-interactions. */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ---- Hero ---- */
.hero {
  background: radial-gradient(ellipse at 20% 0%, rgba(254, 243, 199, 0.7) 0%, var(--color-bg) 70%);
  padding: var(--sp-xl) var(--sp-lg) var(--sp-lg);
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.brand-block {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font: 700 48rpx/1.2 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text);
  letter-spacing: 2rpx;
}

.brand-tag {
  font: 600 24rpx/1.4 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-primary-dark);
  margin-top: var(--sp-xs);
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
  font: var(--font-caption);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.status-pill.open {
  background: var(--color-accent-soft);
  color: var(--color-accent);
}

.status-pill.closed {
  background: var(--color-neutral-soft);
  color: var(--color-text-tertiary);
}

.status-pill .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

/* Primary CTA — gradient + warm glow */
.hero-cta {
  margin-top: var(--sp-lg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--gradient-primary);
  border-radius: var(--radius-pill);
  padding: 26rpx 36rpx;
  box-shadow: var(--shadow-primary);
}

.hero-cta:active {
  background: var(--gradient-primary-active);
  transform: scale(0.99);
}

.cta-text {
  font: 600 32rpx/1 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #fff;
  letter-spacing: 1rpx;
}

.cta-arrow {
  font-size: 40rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1;
  opacity: 0.9;
}

/* ---- Sections ---- */
.section {
  padding: 0 var(--sp-lg);
  margin-top: var(--sp-xl);
}

/* ---- Recommendation ribbon — media cards ---- */
.ribbon {
  width: 100%;
  white-space: nowrap;
}

.ribbon-inner {
  display: inline-flex;
  gap: var(--sp-md);
  padding: var(--sp-sm) 0 var(--sp-md);
}

.ribbon-item {
  display: inline-block;
  animation: fadeUp 0.5s ease-out both;
}

/* Media card: image with overlaid info */
.rec-card {
  width: 260rpx;
  height: 300rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  flex-shrink: 0;
  position: relative;
}

.rec-card:active {
  transform: scale(0.97);
  box-shadow: var(--shadow-sm);
}

.rec-img-wrap {
  width: 100%;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
}

.rec-img {
  width: 100%;
  height: 100%;
  background: var(--color-border);
  display: block;
}

.rec-img-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
}

.ph-icon {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.65;
}

/* Overlay gradient + bottom-laid info */
.rec-card::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.2) 55%, transparent 100%);
  pointer-events: none;
  z-index: 1;
}

.rec-info {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--sp-md);
  display: flex;
  flex-direction: column;
  z-index: 2;
  box-sizing: border-box;
}

.rec-name {
  font: 600 26rpx/1.3 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
}

.rec-price {
  font: 700 30rpx/1 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #FDE68A;
  margin-top: var(--sp-xs);
}

/* Floating add button on media card */
.rec-add {
  position: absolute;
  right: var(--sp-md);
  bottom: var(--sp-md);
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow: var(--shadow-sm);
  z-index: 3;
}

.rec-add:active {
  transform: scale(0.88);
  background: var(--color-primary);
  color: #fff;
}

/* ---- Category pills ---- */
.cat-scroll {
  width: 100%;
  white-space: nowrap;
}

.cat-row {
  display: inline-flex;
  gap: var(--sp-md);
  padding: var(--sp-sm) 0 var(--sp-md);
}

.cat-pill {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: var(--color-surface);
  border-radius: var(--radius-pill);
  font: var(--font-secondary);
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
  transition: all 0.2s ease;
}

.cat-pill:active {
  background: var(--color-primary-soft);
  color: var(--color-primary-dark);
  border-color: var(--color-primary);
  box-shadow: var(--shadow-primary-sm);
}

/* ---- Hot dishes grid ---- */
.hot-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sp-md);
}

.hot-card {
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.hot-card:active {
  transform: scale(0.98);
}

.hot-img-wrap {
  width: 100%;
  height: 320rpx;
}

.hot-img {
  width: 100%;
  height: 100%;
  background: var(--color-border);
  display: block;
}

.hot-img-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
}

.hot-info {
  padding: var(--sp-md) var(--sp-md) var(--sp-lg);
}

.hot-name {
  font: 500 26rpx/1.4 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hot-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-sm);
}

.hot-price {
  font: var(--font-price);
  color: var(--color-primary);
}

.hot-add {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow: var(--shadow-primary-sm);
}

.hot-add:active {
  transform: scale(0.9);
  background: var(--gradient-primary-active);
}

.safe-bottom {
  height: var(--sp-3xl);
}
