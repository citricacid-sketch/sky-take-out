/* components/ai-chat/ai-chat.wxss */
/* Global AI customer service — warm, polished, with breathing FAB and glass panel. */

/* ---- Floating Button: gradient + breathing glow ---- */
.ai-fab {
  position: fixed;
  right: 24rpx;
  bottom: calc(136rpx + env(safe-area-inset-bottom));
  height: 72rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: var(--gradient-primary);
  box-shadow: var(--shadow-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.ai-fab::after {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 999rpx;
  animation: gentlePulse 2.6s ease-out infinite;
  z-index: -1;
}

.ai-fab-hover {
  background: var(--gradient-primary-active);
}

.ai-fab-text {
  font: 600 26rpx/1 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #fff;
  letter-spacing: 1rpx;
}

/* ---- Overlay ---- */
.ai-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.22);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

/* ---- Panel: bottom sheet with warm radial bg ---- */
.ai-panel {
  width: 100%;
  height: 58vh;
  max-height: 62vh;
  background: var(--color-bg);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -8rpx 32rpx rgba(41, 37, 36, 0.12);
  animation: slideUp 0.24s ease-out;
  box-sizing: border-box;
  position: relative;
}

.ai-panel::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 240rpx;
  background: radial-gradient(ellipse at 50% 0%, rgba(254, 243, 199, 0.5) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* ---- Header: glass ---- */
.ai-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 var(--sp-lg);
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border-bottom: 1rpx solid rgba(231, 229, 228, 0.6);
  flex-shrink: 0;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.ai-mode-switch {
  display: flex;
  background: var(--color-surface-alt);
  border-radius: 999rpx;
  padding: 4rpx;
}

.ai-mode-item {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font: 500 26rpx/1 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text-secondary);
  transition: all 0.2s ease;
}

.ai-mode-active {
  background: var(--gradient-primary);
  color: #fff;
  font-weight: 600;
  box-shadow: var(--shadow-primary-sm);
}

.ai-header-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-surface-alt);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}

.ai-header-close:active {
  transform: scale(0.9);
  background: var(--color-border);
}

/* ---- Messages ---- */
.ai-messages {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  padding: var(--sp-lg) var(--sp-xl);
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.ai-msg {
  display: flex;
  align-items: flex-end;
  margin-bottom: var(--sp-lg);
  animation: fadeUp 0.3s ease-out both;
}

.ai-msg-user {
  flex-direction: row-reverse;
}

/* ---- Avatars ---- */
.ai-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
}

.ai-avatar-ai {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  color: var(--color-primary-dark);
  margin-right: var(--sp-md);
  box-shadow: var(--shadow-sm);
}

.ai-avatar-user {
  background: var(--gradient-primary);
  color: #fff;
  margin-left: var(--sp-md);
  box-shadow: var(--shadow-primary-sm);
}

/* ---- Bubble ---- */
.ai-bubble {
  max-width: 72%;
  min-width: 0;
  padding: var(--sp-md) var(--sp-lg);
  border-radius: var(--radius-lg);
  font: var(--font-body);
  line-height: 1.6;
  white-space: normal;
  overflow-wrap: break-word;
  word-break: break-word;
  box-sizing: border-box;
}

.ai-bubble-ai {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  color: var(--color-text);
  border-radius: 4rpx var(--radius-lg) var(--radius-lg) var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.ai-bubble-user {
  background: var(--gradient-primary);
  color: #fff;
  border-radius: var(--radius-lg) 4rpx var(--radius-lg) var(--radius-lg);
  box-shadow: var(--shadow-primary-sm);
}

.ai-bubble-loading {
  color: var(--color-text-tertiary);
}

.ai-dots {
  display: inline-flex;
  gap: 6rpx;
  letter-spacing: 0;
}

.ai-dots text {
  animation: dotBounce 1.2s ease-in-out infinite;
}
.ai-dots text:nth-child(2) { animation-delay: 0.15s; }
.ai-dots text:nth-child(3) { animation-delay: 0.3s; }

/* ---- Quick questions ---- */
.ai-quick {
  padding: var(--sp-md) var(--sp-xl);
  border-top: 1rpx solid rgba(231, 229, 228, 0.6);
  flex-shrink: 0;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.ai-quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-sm);
}

.ai-quick-item {
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  font: 400 24rpx/56rpx -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text-secondary);
}

.ai-quick-item:active {
  background: var(--color-primary-soft);
  border-color: var(--color-primary);
  color: var(--color-primary-dark);
  transform: scale(0.96);
}

/* ---- Input ---- */
.ai-input-row {
  display: flex;
  align-items: center;
  gap: var(--sp-md);
  padding: var(--sp-md) var(--sp-xl);
  padding-bottom: calc(var(--sp-md) + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border-top: 1rpx solid rgba(231, 229, 228, 0.6);
  flex-shrink: 0;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.ai-input {
  flex: 1;
  height: 72rpx;
  background: var(--color-surface);
  border-radius: 999rpx;
  padding: 0 var(--sp-lg);
  font: var(--font-body);
  color: var(--color-text);
  box-sizing: border-box;
  border: 1rpx solid var(--color-border);
}

.ai-input:focus {
  border-color: var(--color-primary);
}

.ai-send {
  padding: 0 var(--sp-lg);
  height: 72rpx;
  border-radius: 999rpx;
  background: var(--gradient-primary);
  color: #fff;
  font: 600 26rpx/72rpx -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-primary-sm);
}

.ai-send:active {
  transform: scale(0.96);
  background: var(--gradient-primary-active);
}

.ai-send-disabled {
  background: var(--color-text-tertiary);
  box-shadow: none;
}

/* ============================================================ */
/* ORDERING MODE                                                  */
/* ============================================================ */

.ai-ordering-scroll {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.ai-ordering-content {
  padding: var(--sp-lg) var(--sp-xl);
  box-sizing: border-box;
}

.ai-ordering-title {
  font: 700 34rpx/1.3 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text);
  margin-bottom: var(--sp-lg);
}

.ai-ordering-section {
  margin-bottom: var(--sp-lg);
}

.ai-ordering-label {
  font: 500 26rpx/1 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text-secondary);
  margin-bottom: var(--sp-sm);
}

.ai-ordering-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-sm);
}

.ai-chip {
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  font: 400 26rpx/64rpx -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text);
}

.ai-chip:active {
  background: var(--color-primary-soft);
  border-color: var(--color-primary);
  color: var(--color-primary-dark);
  transform: scale(0.96);
}

.ai-ordering-example {
  font: 400 24rpx/1.4 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text-tertiary);
  margin-top: var(--sp-sm);
  margin-bottom: var(--sp-lg);
}

/* ---- Recommendations result ---- */
.ai-ordering-result-title {
  font: 600 32rpx/1.3 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text);
  margin-bottom: var(--sp-md);
}

.ai-ordering-explanation {
  font: 400 26rpx/1.6 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: var(--sp-md) var(--sp-lg);
  margin-bottom: var(--sp-lg);
  box-shadow: var(--shadow-sm);
  border-left: 4rpx solid var(--color-primary);
}

.ai-ordering-list {
  margin-bottom: var(--sp-lg);
}

.ai-ordering-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-md) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.ai-ordering-item:last-child {
  border-bottom: none;
}

.ai-ordering-item-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.ai-ordering-item-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-lg);
  margin-right: var(--sp-md);
  flex-shrink: 0;
  background: var(--color-border);
  box-shadow: var(--shadow-sm);
}

.ai-ordering-item-img-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
}

.ai-ordering-item-info {
  flex: 1;
  min-width: 0;
}

.ai-ordering-item-name {
  font: 500 28rpx/1.4 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-ordering-item-reasons {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 4rpx;
}

.ai-ordering-reason {
  font: 400 20rpx/1 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-accent);
}

.ai-ordering-item-right {
  text-align: right;
  margin-left: var(--sp-md);
}

.ai-ordering-item-price {
  font: 600 28rpx/1 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-primary);
  display: block;
}

.ai-ordering-item-flavor-hint {
  font: 400 22rpx/1 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

.ai-ordering-item-action {
  font: 500 24rpx/1 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-text-secondary);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
  margin-top: 8rpx;
}

.ai-ordering-item-action-add {
  color: var(--color-primary);
  border-color: var(--color-primary);
}

/* ---- Summary ---- */
.ai-ordering-summary {
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  padding: var(--sp-lg);
  margin-top: var(--sp-md);
  box-shadow: var(--shadow-sm);
}

.ai-ordering-total {
  font: 700 38rpx/1 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--color-primary);
  display: block;
  text-align: right;
  margin-bottom: var(--sp-md);
}

.ai-ordering-actions {
  display: flex;
  gap: var(--sp-md);
}

.ai-ordering-btn {
  flex: 1;
  height: 84rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  font: 600 28rpx/1 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.ai-ordering-btn-primary {
  background: var(--gradient-primary);
  color: #fff;
  box-shadow: var(--shadow-primary-sm);
}

.ai-ordering-btn-primary:active {
  transform: scale(0.97);
  background: var(--gradient-primary-active);
}

.ai-ordering-btn-secondary {
  background: var(--color-surface-alt);
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
}

.ai-ordering-btn-secondary:active {
  transform: scale(0.97);
  background: var(--color-border);
}

/* ---- Loading ---- */
.ai-ordering-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-3xl) 0;
  color: var(--color-text-tertiary);
  font: 400 26rpx/1 -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.ai-ordering-loading-dots {
  display: flex;
  gap: 12rpx;
  margin-bottom: var(--sp-md);
  font-size: 40rpx;
}

.ai-ordering-loading-dots .dot {
  animation: dotBounce 1.2s ease-in-out infinite;
}
.ai-ordering-loading-dots .dot:nth-child(2) { animation-delay: 0.15s; }
.ai-ordering-loading-dots .dot:nth-child(3) { animation-delay: 0.3s; }
