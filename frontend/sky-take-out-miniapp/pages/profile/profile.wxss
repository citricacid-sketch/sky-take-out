/* pages/profile/profile.wxss */
.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: var(--sp-lg);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.id-card {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  padding: var(--sp-xl);
  margin-bottom: var(--sp-xl);
  border: 1rpx solid var(--color-border);
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  margin-right: var(--sp-lg);
}

.id-info {
  flex: 1;
}

.nickname {
  font: var(--font-section-title);
  color: var(--color-text);
}

.hint {
  font: var(--font-caption);
  color: var(--color-text-secondary);
  margin-top: var(--sp-xs);
}

.login-btn {
  padding: 16rpx 40rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-pill);
  font: var(--font-secondary);
  font-weight: 600;
}

/* Order card */
.order-card {
  padding: var(--sp-lg);
  margin-bottom: var(--sp-lg);
  border: 1rpx solid var(--color-border);
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-lg);
}

.order-title {
  font: var(--font-product-name);
  font-weight: 600;
}

.order-grid {
  display: flex;
  justify-content: space-around;
}

.order-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-sm);
}

.oc-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--sp-sm);
}

.oc-ico-img {
  width: 44rpx;
  height: 44rpx;
}

.oc-label {
  font: var(--font-caption);
  color: var(--color-text-secondary);
}

/* Entry list */
.entry-list {
  padding: 0 var(--sp-lg);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
}

.entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-lg) 0;
}

.entry-label {
  font: var(--font-product-name);
}

.logout-text {
  color: var(--color-danger);
}

.entry-divider {
  height: 1rpx;
  background: var(--color-border);
}

.arrow {
  font-size: 40rpx;
  color: var(--color-text-tertiary);
}

.footer-note {
  padding: 40rpx;
  text-align: center;
  color: var(--color-text-tertiary);
  font: var(--font-caption);
  opacity: 0.6;
}

.safe-bottom {
  height: var(--sp-3xl);
}
